# ============================================
# Gestionnaire de société — Variables d'env
# Copiez ce fichier vers .env et adaptez-le.
# ============================================

# Django
DJANGO_SECRET_KEY=changez-cette-cle-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email / SMTP (Brevo relay : https://app.brevo.com/settings/keys/smtp) ---
# True = affiche les emails dans la console (dev, aucun SMTP requis)
EMAIL_CONSOLE=True
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Doit être un expéditeur validé chez Brevo
DEFAULT_FROM_EMAIL=

# --- Google OAuth2 (connexion sociale allauth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Allauth ---
# http en local, https en production
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# --- KPay (Mobile Money) ---
# Clé publique : kpay_test_ (sandbox) ou kpay_live_ (production) ; clé secrète : 64 hex sans préfixe.
# KPAY_GATEWAY_SECRET : signature du retour passerelle ; KPAY_WEBHOOK_SECRET : signature des webhooks.
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_GATEWAY_SECRET=
KPAY_WEBHOOK_SECRET=
KPAY_BASE_URL=https://admin.kpay.site

# --- IA (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Connecteurs (chiffrement des identifiants au repos) ---
# Optionnel : si vide, une clé dérivée de DJANGO_SECRET_KEY est utilisée.
# En production, définir une clé Fernet dédiée (64 hex).
CONNECTEURS_ENCRYPTION_KEY=

# --- Stockage privé (optionnel, chemins par défaut gérés par Django) ---
# CHAT_MEDIA_ROOT=
# TACHE_MEDIA_ROOT=
