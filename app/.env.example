# ============================================
# Gestionnaire de société — Variables d'env
# Copiez ce fichier vers .env et adaptez-le.
# ============================================

# Django
DJANGO_SECRET_KEY=changez-cette-cle-en-production
# False en production
DJANGO_DEBUG=True
# Domaines publics du site, séparés par des virgules
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://appsfortesting.alwaysdata.net

# --- Sécurité HTTPS (à activer en production, derrière un proxy HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Email / SMTP (Brevo : https://app.brevo.com/settings/keys/smtp) ---
# True = affiche les emails dans la console (dev, aucun SMTP requis)
# False = envoi réel via le serveur SMTP ci-dessous
EMAIL_CONSOLE=False
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Login SMTP Brevo
EMAIL_HOST_USER=
# Clé SMTP Brevo
EMAIL_HOST_PASSWORD=
# Expéditeur vérifié chez Brevo. Si vide, EMAIL_HOST_USER est utilisé.
DEFAULT_FROM_EMAIL=

# --- Google OAuth2 (connexion sociale allauth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Site public / Allauth ---
# URL publique utilisée dans les e-mails et liens absolus
SITE_URL=https://appsfortesting.alwaysdata.net
# http en local, https en production
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# --- KPay (Mobile Money) ---
# Clé publique : kpay_test_ (sandbox) ou kpay_live_ (production) ; clé secrète : 64 hex sans préfixe.
# KPAY_GATEWAY_SECRET : signature du retour passerelle ; KPAY_WEBHOOK_SECRET : signature des webhooks.
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_GATEWAY_SECRET=
KPAY_WEBHOOK_SECRET=
KPAY_BASE_URL=https://admin.kpay.site

# --- IA (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Connecteurs (chiffrement des identifiants au repos) ---
# Optionnel : si vide, une clé dérivée de DJANGO_SECRET_KEY est utilisée.
# En production, définir une clé Fernet dédiée (64 hex).
CONNECTEURS_ENCRYPTION_KEY=

# --- Stockage privé (optionnel, chemins par défaut gérés par Django) ---
# CHAT_MEDIA_ROOT=
# TACHE_MEDIA_ROOT=
